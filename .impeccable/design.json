      "css": ".ds-toast{display:inline-flex;align-items:center;gap:.75rem;padding:.5rem 1rem;border-radius:3px;background:#111214;color:#fff;font:400 .875rem/1.5 'Hanken Grotesk Var',system-ui,sans-serif;box-shadow:0 4px 16px rgba(0,0,0,.25)}.ds-toast-btn{border:0;background:none;padding:0;font:inherit;font-weight:600;color:color-mix(in srgb,var(--accent, #C4201A) 65%,white);cursor:pointer}.ds-toast-btn:focus-visible{outline:2px solid #fff;outline-offset:2px;border-radius:2px}"
