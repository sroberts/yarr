  "components": [
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "The resting action button: paper well, edge outline, a faint press shadow that drops when pressed.",
      "html": "<button class=\"ds-btn-default\">Add your first feed</button>",
      "css": ".ds-btn-default{font:400 15px/1.5 'Hanken Grotesk Var',system-ui,sans-serif;padding:.375rem .75rem;background:var(--surface-base, #FFFFFF);color:var(--text-primary, #111214);border:1px solid var(--border-strong, #C3C7CD);border-radius:3px;box-shadow:0 1px 2px rgba(0,0,0,.1);cursor:pointer;transition:background-color .12s ease,border-color .12s ease}.ds-btn-default:hover{background:var(--surface-hover, #E6E8EB)}.ds-btn-default:active{background:var(--surface-hover, #E6E8EB);box-shadow:none}.ds-btn-default:focus-visible{outline:2px solid var(--accent, #C4201A);outline-offset:2px;border-color:var(--accent, #C4201A)}"
    },
    {
      "name": "Star Button",
      "kind": "button",
      "refersTo": "button-star",
      "description": "The keeper verb in triage: marker outline and marker label, the one labelled button in the legend.",
      "html": "<button class=\"ds-btn-star\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z\"/></svg>Star</button>",
      "css": ".ds-btn-star{display:inline-flex;align-items:center;gap:.35rem;min-height:2rem;padding:.25rem .85rem;border:1px solid var(--accent, #C4201A);border-radius:3px;background:var(--surface-base, #FFFFFF);color:var(--accent, #C4201A);font:600 15px/1.5 'Hanken Grotesk Var',system-ui,sans-serif;cursor:pointer;transition:background-color .12s ease}.ds-btn-star:hover{background:var(--surface-hover, #E6E8EB)}.ds-btn-star:focus-visible{outline:2px solid var(--accent, #C4201A);outline-offset:2px}"
    },
    {
      "name": "Toolbar Item",
      "kind": "button",
      "refersTo": "toolbar-item",
      "description": "Icon control in the 2rem toolbar; hover steps to the hover surface, toggled-on inverts to ink.",
      "html": "<div class=\"ds-toolbar\"><button class=\"ds-tool\" aria-label=\"Unread\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"7\"/></svg></button><button class=\"ds-tool active\" aria-pressed=\"true\" aria-label=\"All\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 6h16M4 12h10M4 18h14\"/></svg></button></div>",
      "css": ".ds-toolbar{display:flex;gap:4px;color:var(--text-primary, #111214)}.ds-tool{display:inline-flex;align-items:center;justify-content:center;padding:.25rem .5rem;border:1px solid transparent;border-radius:3px;background:transparent;color:inherit;line-height:1;cursor:pointer;transition:background-color .12s ease,color .12s ease}.ds-tool:hover{background:var(--surface-hover, #E6E8EB)}.ds-tool.active{background:var(--ink-select, #111214);color:var(--on-ink-select, #FFFFFF)}.ds-tool:focus-visible{outline:2px solid var(--accent, #C4201A);outline-offset:2px}"
    },
    {
      "name": "Search Field and Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper well with an edge outline; focus turns the border to the marker and adds the marker ring.",
      "html": "<input class=\"ds-input\" placeholder=\"Feed URL\">",
      "css": ".ds-input{display:block;width:100%;max-width:20rem;padding:.375rem .75rem;font:400 15px/1.5 'Hanken Grotesk Var',system-ui,sans-serif;background:var(--surface-base, #FFFFFF);color:var(--text-primary, #111214);border:1px solid var(--border-strong, #C3C7CD);border-radius:3px;box-shadow:inset 0 1px 1px rgba(0,0,0,.07)}.ds-input::placeholder{color:var(--text-tertiary, #61666E);opacity:1}.ds-input:focus{border-color:var(--accent, #C4201A);outline:none}.ds-input:focus-visible{outline:2px solid var(--accent, #C4201A);outline-offset:2px}"
    },
    {
      "name": "Feed Sidebar Row",
      "kind": "nav",
      "refersTo": "feed-row-selected",
      "description": "Feed rows on the grey board with mono counts; the selected row is inverted to ink and its count inverts with it.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-row\" href=\"#\">All Feeds<span class=\"ds-count\">20</span></a><a class=\"ds-nav-row selected\" href=\"#\">Engineering<span class=\"ds-count\">6</span></a><a class=\"ds-nav-row\" href=\"#\">News<span class=\"ds-count\">8</span></a></nav>",
      "css": ".ds-nav{width:250px;padding:.5rem;background:var(--surface-raised, #F1F2F4);font:400 15px/1.5 'Hanken Grotesk Var',system-ui,sans-serif}.ds-nav-row{display:flex;justify-content:space-between;padding:.375rem .5rem;border-radius:3px;color:var(--text-primary, #111214);text-decoration:none;transition:background-color .12s ease,color .12s ease}.ds-nav-row+.ds-nav-row{margin-top:.25rem}.ds-nav-row:hover{background:var(--surface-hover, #E6E8EB)}.ds-nav-row.selected{background:var(--ink-select, #111214);color:var(--on-ink-select, #FFFFFF)}.ds-count{font:400 .78rem/1.9 'JetBrains Mono Var',Menlo,monospace;font-variant-numeric:tabular-nums;color:var(--text-secondary, #4A4F57)}.ds-nav-row.selected .ds-count{color:var(--on-ink-select, #FFFFFF)}.ds-nav-row:focus-visible{outline:2px solid var(--accent, #C4201A);outline-offset:-2px}"
    },
    {
      "name": "The Roll",
      "kind": "custom",
      "refersTo": "rebate-band",
      "description": "The article list as film: a rebate band of mono frame numbers, bright when unread, faded when seen, marker-ringed when starred; the selected frame is an inset ink outline.",
      "html": "<div class=\"ds-roll\"><div class=\"ds-frame\"><span class=\"ds-fno starred\"><span>01</span></span><div class=\"ds-meta\">Systems Notebook · 2d</div><div class=\"ds-title\">Self-hosting without the yak shave</div></div><div class=\"ds-frame selected\"><span class=\"ds-fno sel\"><span>02</span></span><div class=\"ds-meta\">Long Reads Weekly · 3d</div><div class=\"ds-title\">On reading slowly</div></div><div class=\"ds-frame\"><span class=\"ds-fno unread\"><span>03</span></span><div class=\"ds-meta\">Systems Notebook · 7d</div><div class=\"ds-title unread\">Notes on keyboard-first interfaces</div></div></div>",
      "css": ".ds-roll{width:320px;padding:.5rem .5rem .5rem 0;background-color:var(--surface-base, #FFFFFF);background-image:linear-gradient(90deg,var(--rebate, #111214) 40px,transparent 40px);font:400 15px/1.5 'Hanken Grotesk Var',system-ui,sans-serif}.ds-frame{position:relative;margin-left:calc(40px + .5rem);padding:.375rem .5rem;border-radius:3px}.ds-frame+.ds-frame{margin-top:.25rem}.ds-frame.selected{box-shadow:inset 0 0 0 2px var(--ink-select, #111214)}.ds-meta{font-size:.8rem;line-height:1.2;color:var(--text-tertiary, #61666E)}.ds-title{color:var(--text-secondary, #4A4F57)}.ds-title.unread{font-weight:600;color:var(--text-primary, #111214)}.ds-frame.selected .ds-title{color:var(--text-primary, #111214)}.ds-fno{position:absolute;top:0;bottom:0;left:calc(-1 * (40px + .5rem));width:40px;display:flex;justify-content:center;padding-top:.55rem;font:500 .72rem/1 'JetBrains Mono Var',Menlo,monospace;font-variant-numeric:tabular-nums;letter-spacing:.02em;color:var(--rebate-text, #8E939B)}.ds-fno>span{display:inline-block;height:max-content;padding:.2rem .25rem;border-radius:2px}.ds-fno.unread{color:var(--rebate-text-strong, #FFFFFF);font-weight:700}.ds-fno.starred>span{color:var(--rebate-text-strong, #FFFFFF);box-shadow:0 0 0 2px var(--marker-on-rebate, #FF6B5E);border-radius:50% 45% 55% 48%;transform:rotate(-4deg)}.ds-fno.sel>span{background:var(--surface-base, #FFFFFF);color:var(--text-primary, #111214);font-weight:700}"
    },
    {
      "name": "Frame Tag",
      "kind": "chip",
      "refersTo": "frame-tag",
      "description": "Inverted rebate stamp giving the open article's place on the roll; ringed in marker when the article is starred.",
      "html": "<span class=\"ds-frame-label\">Frame <b class=\"ds-ftag\">07</b> of 15</span> <span class=\"ds-frame-label\">Frame <b class=\"ds-ftag starred\">02</b> of 16</span>",
      "css": ".ds-frame-label{font:400 .8rem/1.5 'Hanken Grotesk Var',system-ui,sans-serif;color:var(--text-tertiary, #61666E);margin-right:1rem}.ds-ftag{display:inline-block;margin:0 .3em;padding:.1rem .3rem;border-radius:2px;background:var(--rebate, #111214);color:var(--rebate-text-strong, #FFFFFF);font:600 .75rem/1.2 'JetBrains Mono Var',Menlo,monospace;font-variant-numeric:tabular-nums}.ds-ftag.starred{box-shadow:0 0 0 2px var(--marker-on-rebate, #FF6B5E)}"
    },
    {
      "name": "Triage Card",
      "kind": "card",
      "refersTo": "triage-card",
      "description": "A single print on the grey board: paper, edge outline, square corners, its own rebate strip, Literata headline and excerpt.",
      "html": "<div class=\"ds-board\"><article class=\"ds-card\"><div class=\"ds-card-rebate\"><span>01</span></div><div class=\"ds-card-feed\"><span>Long Reads Weekly</span><span>7h</span></div><div class=\"ds-card-title\">On reading slowly</div><p class=\"ds-card-excerpt\">An argument for letting the backlog wait, and for reading the few things you keep all the way through.</p><div class=\"ds-card-foot\">Enter to read here</div></article></div>",
      "css": ".ds-board{padding:1.25rem;background:var(--surface-raised, #F1F2F4)}.ds-card{position:relative;max-width:400px;overflow:hidden;padding:1.5rem 1.5rem 1.5rem calc(40px + 1.25rem);background:var(--surface-base, #FFFFFF);color:var(--text-primary, #111214);border:1px solid var(--border-strong, #C3C7CD);border-radius:3px;font:400 15px/1.5 'Hanken Grotesk Var',system-ui,sans-serif}.ds-card-rebate{position:absolute;top:0;bottom:0;left:0;width:40px;display:flex;justify-content:center;padding-top:1.55rem;background:var(--rebate, #111214);color:var(--rebate-text-strong, #FFFFFF);font:700 .78rem/1 'JetBrains Mono Var',Menlo,monospace;font-variant-numeric:tabular-nums}.ds-card-feed{display:flex;justify-content:space-between;font-size:.8rem;color:var(--text-tertiary, #61666E);margin-bottom:.75rem}.ds-card-title{font:600 1.4rem/1.25 'Literata Var',Georgia,serif;margin-bottom:.75rem;text-wrap:balance}.ds-card-excerpt{font:400 1rem/1.6 'Literata Var',Georgia,serif;color:var(--text-secondary, #4A4F57);margin:0}.ds-card-foot{margin-top:.75rem;padding-top:.5rem;border-top:1px solid var(--border-subtle, #E1E3E7);font-size:.8rem;color:var(--text-tertiary, #61666E)}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented-active",
      "description": "Settings toggle: a bordered track of equal 44px segments; the active segment is inverted to ink.",
      "html": "<div class=\"ds-seg\"><button>auto</button><button class=\"active\" aria-pressed=\"true\">light</button><button>dark</button></div>",
      "css": ".ds-seg{display:flex;max-width:20rem;border:1px solid var(--border-strong, #C3C7CD);border-radius:3px;overflow:hidden}.ds-seg>button{flex:1;min-height:44px;padding:.4rem .5rem;border:0;border-left:1px solid var(--border-subtle, #E1E3E7);background:transparent;color:var(--text-primary, #111214);font:400 15px/1.5 'Hanken Grotesk Var',system-ui,sans-serif;cursor:pointer;transition:background-color .12s ease,color .12s ease}.ds-seg>button:first-child{border-left:0}.ds-seg>button:hover{background:var(--surface-hover, #E6E8EB)}.ds-seg>button.active{background:var(--ink-select, #111214);color:var(--on-ink-select, #FFFFFF)}.ds-seg>button:focus-visible{outline:2px solid var(--accent, #C4201A);outline-offset:-2px}"
    },
    {
      "name": "Undo Toast",
      "kind": "custom",
